# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so it must never hold a real value.

# Read only by the integration and e2e test tiers, which do not run in CI and are run by
# hand with `make integration-tests` / `make e2e-tests`. A test skips itself when what it
# needs is absent. See docs/design/testing.md.

# Tavily API key — the `web_search` tool enbanc ships. Named here because this provider is
# the library's, not yours: web_search is written against Tavily's SDK and tavily-python is
# a core dependency. See docs/decisions/0018-the-search-client-is-a-core-dependency.md.
TAVILY_API_KEY=

# The model the live tiers run against, as a pydantic-ai model string — for example
# `anthropic:claude-sonnet-5`, `openai:gpt-5`, or `google-gla:gemini-2.5-pro`. enbanc has no
# provider concept and commits to working with any pydantic_ai.models.Model, so which one the
# live tiers use is yours to choose and no provider is named here.
ENBANC_TEST_MODEL=

# Whatever credential the provider above needs, read by PydanticAI from the environment
# under that provider's own variable name. Add the one line your choice of ENBANC_TEST_MODEL
# requires; PydanticAI's error names the variable if you get it wrong, and the live tiers
# turn that error into a skip rather than a failure.
